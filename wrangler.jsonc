{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "deja",
	"main": "worker/src/index.ts",
	"compatibility_date": "2026-11-01",
	// API only. The app itself is on GitHub Pages at deja.litkowski.com.
	"routes": [
		{
			"pattern": "deja-api.litkowski.com",
			"custom_domain": true
		}
	],
	// GOOGLE_CLIENT_SECRET is a secret: `wrangler secret put GOOGLE_CLIENT_SECRET`, locally in .dev.vars.
	"vars": {
		"GOOGLE_CLIENT_ID": "97369815483-mda24ub122rknlfvsrnc3hvh842jiarn.apps.googleusercontent.com",
		// TODO: remove https://nlitkowski.github.io once progress has moved to deja.litkowski.com.
		"ALLOWED_ORIGINS": "https://deja.litkowski.com,http://localhost:5173,https://nlitkowski.github.io"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "deja",
			"database_id": "ee6882ee-8289-405a-8ce1-28efb847917e",
			"migrations_dir": "worker/migrations"
		}
	],
	"env": {
		"staging": {
			"name": "deja-staging",
			// Routes are inherited; without this, deploying staging would take deja-api.litkowski.com from production.
			"routes": [],
			"vars": {
				"GOOGLE_CLIENT_ID": "97369815483-mda24ub122rknlfvsrnc3hvh842jiarn.apps.googleusercontent.com",
				"ALLOWED_ORIGINS": "http://localhost:5173"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "deja-staging",
					"database_id": "e585edbf-a7bb-4084-8d6e-03718c2fe881",
					"migrations_dir": "worker/migrations"
				}
			]
		}
	}
}
