GOOGLE_CLIENT_SECRET=

# Azure AI Speech (TTS at build time, pronunciation assessment later): Keys and Endpoint in the Azure portal
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# Cloudflare R2 bucket deja-audio (S3 API token with Object Read & Write on that bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional: lets `npm run tts -- --prune --yes` purge deleted recordings from the edge cache
# (zone litkowski.com: Overview › Zone ID; API token with Zone › Cache Purge on that zone)
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_PURGE_TOKEN=
