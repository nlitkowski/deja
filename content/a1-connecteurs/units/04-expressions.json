{
  "id": "04-expressions",
  "title": "Expressions",
  "icon": "🧭",
  "entries": [
    {
      "id": "expr-de-a",
      "fr": "de… à…",
      "pl": "od… do… (czas, miejsce)",
      "def": "le début et la fin (heures, jours, trajet)",
      "examples": [
        {
          "fr": "Je travaille de 9h à 17h.",
          "pl": "Pracuję od 9 do 17."
        },
        {
          "fr": "Le magasin est ouvert du lundi au samedi.",
          "pl": "Sklep jest otwarty od poniedziałku do soboty."
        }
      ],
      "tip": {
        "pl": "z rodzajnikiem: du lundi au vendredi (de + le, à + le)",
        "fr": "avec article : du lundi au vendredi (de + le, à + le)"
      },
      "confusables": [
        "contr-au-aux",
        "contr-du-des"
      ],
      "tags": [
        "temps"
      ]
    },
    {
      "id": "expr-en-mois",
      "fr": "en + miesiąc / rok",
      "pl": "w (miesiącu / roku)",
      "def": "avec les mois et les années",
      "examples": [
        {
          "fr": "Mon anniversaire est en janvier.",
          "pl": "Moje urodziny są w styczniu."
        },
        {
          "fr": "Je suis arrivé en 2024.",
          "pl": "Przyjechałem w 2024 roku."
        }
      ],
      "tip": {
        "pl": "en janvier, en 2024; ale à 8 heures i dans 5 minutes",
        "fr": "en janvier, en 2024 ; mais à 8 heures et dans 5 minutes"
      },
      "confusables": [
        "prep-dans",
        "prep-a"
      ],
      "tags": [
        "temps"
      ]
    },
    {
      "id": "expr-a-cote-de",
      "fr": "à côté de",
      "pl": "obok",
      "def": "tout près, juste à droite ou à gauche",
      "examples": [
        {
          "fr": "La boulangerie est à côté de la gare.",
          "pl": "Piekarnia jest obok dworca."
        }
      ],
      "tip": {
        "pl": "de + le = du: à côté du cinéma",
        "fr": "de + le = du : à côté du cinéma"
      },
      "confusables": [
        "expr-pres-de",
        "expr-en-face-de"
      ],
      "tags": [
        "lieu"
      ]
    },
    {
      "id": "expr-en-face-de",
      "fr": "en face de",
      "pl": "naprzeciwko",
      "def": "de l’autre côté, face à face",
      "examples": [
        {
          "fr": "La pharmacie est en face de l'école.",
          "pl": "Apteka jest naprzeciwko szkoły."
        }
      ],
      "tip": {
        "pl": "de + le = du: en face du parc",
        "fr": "de + le = du : en face du parc"
      },
      "confusables": [
        "expr-a-cote-de",
        "prep-position"
      ],
      "tags": [
        "lieu"
      ]
    },
    {
      "id": "expr-pres-de",
      "fr": "près de",
      "pl": "blisko",
      "def": "pas loin",
      "examples": [
        {
          "fr": "J'habite près de la gare.",
          "pl": "Mieszkam blisko dworca."
        }
      ],
      "tip": {
        "pl": "près de chez moi = blisko mnie (mojego domu)",
        "fr": "près de chez moi = pas loin de ma maison"
      },
      "confusables": [
        "expr-loin-de",
        "expr-a-cote-de"
      ],
      "tags": [
        "lieu"
      ]
    },
    {
      "id": "expr-loin-de",
      "fr": "loin de",
      "pl": "daleko od",
      "def": "à une grande distance",
      "examples": [
        {
          "fr": "La maison est loin de la ville.",
          "pl": "Dom jest daleko od miasta."
        }
      ],
      "tip": {
        "pl": "przed samogłoską loin d': loin d'ici",
        "fr": "devant une voyelle : loin d'ici"
      },
      "confusables": [
        "expr-pres-de"
      ],
      "tags": [
        "lieu"
      ]
    },
    {
      "id": "expr-transport-en",
      "fr": "en + voiture / bus / avion / train / métro",
      "pl": "(jechać) samochodem / autobusem / samolotem… — w środku pojazdu",
      "def": "transport fermé : on est dedans",
      "examples": [
        {
          "fr": "Je vais au travail en métro.",
          "pl": "Jeżdżę do pracy metrem."
        },
        {
          "fr": "Nous partons en avion.",
          "pl": "Lecimy samolotem."
        }
      ],
      "tip": {
        "pl": "en = siedzisz w środku pojazdu",
        "fr": "« en » = on est à l’intérieur du véhicule"
      },
      "confusables": [
        "expr-transport-a"
      ],
      "tags": [
        "transport"
      ]
    },
    {
      "id": "expr-transport-a",
      "fr": "à + pied / vélo / moto / cheval",
      "pl": "pieszo / rowerem / motocyklem / konno — na czymś, otwarte",
      "def": "transport ouvert : on est dessus, ou on marche",
      "examples": [
        {
          "fr": "Je vais à l'école à pied.",
          "pl": "Chodzę do szkoły pieszo."
        },
        {
          "fr": "Il va au travail à vélo.",
          "pl": "On jeździ do pracy rowerem."
        }
      ],
      "tip": {
        "pl": "à = siedzisz na czymś (rower, koń) albo idziesz pieszo",
        "fr": "« à » = on est sur quelque chose (vélo, cheval) ou on marche"
      },
      "confusables": [
        "expr-transport-en"
      ],
      "tags": [
        "transport"
      ]
    }
  ],
