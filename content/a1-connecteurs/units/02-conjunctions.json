{
  "id": "02-conjunctions",
  "title": "Conjonctions",
  "icon": "🧩",
  "entries": [
    {
      "id": "conj-et",
      "fr": "et",
      "pl": "i, oraz",
      "def": "addition : une chose et aussi une autre",
      "examples": [
        {
          "fr": "J'aime le café et le thé.",
          "pl": "Lubię kawę i herbatę."
        }
      ],
      "tags": [
        "coordination"
      ]
    },
    {
      "id": "conj-ou",
      "fr": "ou",
      "pl": "lub, albo, czy",
      "def": "un choix entre deux choses",
      "examples": [
        {
          "fr": "Tu veux du café ou du thé ?",
          "pl": "Chcesz kawę czy herbatę?"
        }
      ],
      "tip": {
        "pl": "nie mylić z où (gdzie)",
        "fr": "ne pas confondre avec « où » (le lieu)"
      },
      "confusables": [
        "adv-ou"
      ],
      "tags": [
        "coordination"
      ]
    },
    {
      "id": "adv-ou",
      "fr": "où",
      "pl": "gdzie",
      "def": "question sur le lieu",
      "examples": [
        {
          "fr": "Où est la gare ?",
          "pl": "Gdzie jest dworzec?"
        },
        {
          "fr": "Je ne sais pas où il habite.",
          "pl": "Nie wiem, gdzie on mieszka."
        }
      ],
      "tip": {
        "pl": "où (z akcentem) = gdzie; ou (bez akcentu) = lub",
        "fr": "« où » (avec accent) = le lieu ; « ou » (sans accent) = un choix"
      },
      "confusables": [
        "conj-ou"
      ],
      "tags": [
        "question"
      ]
    },
    {
      "id": "conj-mais",
      "fr": "mais",
      "pl": "ale, lecz",
      "def": "l'opposition",
      "examples": [
        {
          "fr": "Je suis fatigué mais content.",
          "pl": "Jestem zmęczony, ale zadowolony."
        }
      ],
      "tags": [
        "coordination"
      ]
    },
    {
      "id": "conj-donc",
      "fr": "donc",
      "pl": "więc, zatem",
      "def": "la conséquence",
      "examples": [
        {
          "fr": "Il pleut, donc je prends un parapluie.",
          "pl": "Pada, więc biorę parasol."
        }
      ],
      "tags": [
        "coordination"
      ]
    },
    {
      "id": "conj-ni",
      "fr": "ni… ni…",
      "pl": "ani… ani…",
      "def": "la négation de deux choses",
      "examples": [
        {
          "fr": "Je ne veux ni café ni thé.",
          "pl": "Nie chcę ani kawy, ani herbaty."
        }
      ],
      "tip": {
        "pl": "wymaga ne przed czasownikiem; po ni zwykle bez rodzajnika cząstkowego",
        "fr": "avec « ne » avant le verbe ; après « ni », en général pas d’article"
      },
      "tags": [
        "coordination"
      ]
    },
    {
      "id": "conj-car",
      "fr": "car",
      "pl": "bo, ponieważ (formalniej)",
      "def": "la cause, l’explication (plus formel)",
      "examples": [
        {
          "fr": "Je reste chez moi, car je suis malade.",
          "pl": "Zostaję w domu, bo jestem chory."
        }
      ],
      "tip": {
        "pl": "car stoi w środku zdania, po przecinku; nigdy na początku",
        "fr": "« car » se place au milieu de la phrase, après une virgule ; jamais au début"
      },
      "confusables": [
        "conj-parce-que",
        "conj-comme"
      ],
      "tags": [
        "coordination",
        "cause"
      ]
    },
    {
      "id": "conj-parce-que",
      "fr": "parce que / parce qu'",
      "pl": "ponieważ, dlatego że",
      "def": "la cause ; la réponse à « pourquoi ? »",
      "examples": [
        {
          "fr": "Je suis heureux parce que c'est vendredi.",
          "pl": "Jestem szczęśliwy, bo jest piątek."
        }
      ],
      "tip": {
        "pl": "przed samogłoską parce qu'il; odpowiedź na pourquoi ? zaczyna się od parce que",
        "fr": "devant une voyelle : parce qu'il ; on répond à « pourquoi ? » avec « parce que »"
      },
      "confusables": [
        "conj-car",
        "conj-comme"
      ],
      "tags": [
        "subordination",
        "cause"
      ]
    },
    {
      "id": "conj-quand",
      "fr": "quand",
      "pl": "kiedy, gdy",
      "def": "le moment",
      "examples": [
        {
          "fr": "Quand je suis fatigué, je dors.",
          "pl": "Kiedy jestem zmęczony, śpię."
        }
      ],
      "confusables": [
        "conj-si"
      ],
      "tags": [
        "subordination",
        "temps"
      ]
    },
    {
      "id": "conj-si",
      "fr": "si",
      "pl": "jeśli; czy",
      "def": "la condition ; une question indirecte (oui ou non)",
      "examples": [
        {
          "fr": "Si tu veux, on peut partir.",
          "pl": "Jeśli chcesz, możemy wyjść."
        },
        {
          "fr": "Je ne sais pas si c'est vrai.",
          "pl": "Nie wiem, czy to prawda."
        }
      ],
      "tip": {
        "pl": "s'il / s'ils, ale si elle (bez elizji)",
        "fr": "s'il / s'ils, mais si elle (pas d’élision)"
      },
      "confusables": [
        "conj-quand"
      ],
      "tags": [
        "subordination"
      ]
    },
    {
      "id": "conj-que",
      "fr": "que / qu'",
      "pl": "że",
      "def": "introduit ce qu’on pense ou ce qu’on dit",
      "examples": [
        {
          "fr": "Je pense que c'est bien.",
          "pl": "Myślę, że to dobrze."
        },
        {
          "fr": "Il dit qu'il est content.",
          "pl": "Mówi, że jest zadowolony."
        }
      ],
      "tip": {
        "pl": "przed samogłoską qu': qu'il, qu'elle",
        "fr": "devant une voyelle : qu'il, qu'elle"
      },
      "tags": [
        "subordination"
      ]
    },
    {
      "id": "conj-comme",
      "fr": "comme",
      "pl": "ponieważ (na początku zdania); jak",
      "def": "la cause (au début de la phrase) ; la comparaison",
      "examples": [
        {
          "fr": "Comme il pleut, je reste ici.",
          "pl": "Ponieważ pada, zostaję tutaj."
        },
        {
          "fr": "Elle est belle comme le soleil.",
          "pl": "Jest piękna jak słońce."
        }
      ],
      "tip": {
        "pl": "comme = ponieważ tylko na początku zdania; w środku użyj parce que albo car",
        "fr": "« comme » = cause seulement au début de la phrase ; au milieu, utilise « parce que » ou « car »"
      },
      "confusables": [
        "conj-car",
        "conj-parce-que"
      ],
      "tags": [
        "subordination",
        "cause"
      ]
    }
  ],
