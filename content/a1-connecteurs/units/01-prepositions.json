{
  "id": "01-prepositions",
  "title": "Prépositions",
  "icon": "📍",
  "entries": [
    {
      "id": "prep-dans",
      "fr": "dans",
      "pl": "w, do (wewnątrz); za (czas w przyszłości)",
      "def": "à l'intérieur de ; + durée = après ce temps, dans le futur",
      "examples": [
        {
          "fr": "Le chat est dans la boîte.",
          "pl": "Kot jest w pudełku."
        },
        {
          "fr": "Je pars dans cinq minutes.",
          "pl": "Wyjeżdżam za pięć minut."
        }
      ],
      "tip": {
        "pl": "dans = zamknięta przestrzeń albo „za ile” w przyszłości",
        "fr": "« dans » = un espace fermé, ou « après combien de temps » dans le futur"
      },
      "confusables": [
        "prep-en",
        "prep-pendant-depuis"
      ],
      "tags": [
        "lieu",
        "temps"
      ]
    },
    {
      "id": "prep-en",
      "fr": "en",
      "pl": "w (kraj żeński / transport zamknięty / czas wykonania); materiał",
      "def": "+ pays féminin ; + transport fermé ; + durée = temps pour faire quelque chose",
      "examples": [
        {
          "fr": "J'habite en France.",
          "pl": "Mieszkam we Francji."
        },
        {
          "fr": "Je voyage en train.",
          "pl": "Podróżuję pociągiem."
        },
        {
          "fr": "J'ai fini en deux heures.",
          "pl": "Skończyłem w dwie godziny."
        }
      ],
      "tip": {
        "pl": "en + kraj żeński vs au + kraj męski; en voiture/avion vs à vélo/pied",
        "fr": "en + pays féminin, au + pays masculin ; en voiture / en avion, mais à vélo / à pied"
      },
      "confusables": [
        "prep-dans",
        "prep-a",
        "prep-pendant-depuis"
      ],
      "tags": [
        "lieu",
        "temps",
        "transport"
      ]
    },
    {
      "id": "prep-a",
      "fr": "à",
      "pl": "do, w, na (miejsce / godzina / smak)",
      "def": "le lieu, la ville, l’heure, le goût",
      "examples": [
        {
          "fr": "Je vais à Paris.",
          "pl": "Jadę do Paryża."
        },
        {
          "fr": "Le cours commence à 8 heures.",
          "pl": "Kurs zaczyna się o 8."
        },
        {
          "fr": "Une glace à la vanille.",
          "pl": "Lody waniliowe."
        }
      ],
      "tip": {
        "pl": "à + le = au, à + les = aux; z la i l' bez zmian",
        "fr": "à + le = au, à + les = aux ; à la et à l' ne changent pas"
      },
      "confusables": [
        "prep-en",
        "prep-chez"
      ],
      "tags": [
        "lieu",
        "temps"
      ]
    },
    {
      "id": "prep-de",
      "fr": "de",
      "pl": "z, od, o (pochodzenie / przynależność / temat)",
      "def": "l'origine, la possession, le sujet",
      "examples": [
        {
          "fr": "Je viens de Pologne.",
          "pl": "Pochodzę z Polski."
        },
        {
          "fr": "Le livre de Marie.",
          "pl": "Książka Marii."
        },
        {
          "fr": "On parle de politique.",
          "pl": "Rozmawiamy o polityce."
        }
      ],
      "tip": {
        "pl": "de + le = du, de + les = des",
        "fr": "de + le = du, de + les = des"
      },
      "confusables": [
        "prep-sur"
      ],
      "tags": [
        "lieu"
      ]
    },
    {
      "id": "prep-pour",
      "fr": "pour",
      "pl": "dla, żeby, na (cel / przeznaczenie / planowany czas)",
      "def": "le but, le destinataire, la durée prévue",
      "examples": [
        {
          "fr": "C'est pour toi.",
          "pl": "To dla ciebie."
        },
        {
          "fr": "Je travaille pour apprendre.",
          "pl": "Pracuję, żeby się uczyć."
        },
        {
          "fr": "Je pars pour deux semaines.",
          "pl": "Wyjeżdżam na dwa tygodnie."
        }
      ],
      "tip": {
        "pl": "pour + planowany czas (na ile wyjeżdżam); pendant = ile coś faktycznie trwało",
        "fr": "« pour » + durée prévue (je pars pour une semaine) ; « pendant » = durée réelle"
      },
      "confusables": [
        "prep-pendant-depuis"
      ]
    },
    {
      "id": "prep-sur",
      "fr": "sur",
      "pl": "na (powierzchnia); o (temat)",
      "def": "sur une surface ; à propos d’un sujet",
      "examples": [
        {
          "fr": "Le verre est sur la table.",
          "pl": "Szklanka jest na stole."
        },
        {
          "fr": "Un film sur la nature.",
          "pl": "Film o naturze."
        }
      ],
      "tip": {
        "pl": "sur = na powierzchni; nie mylić z sûr (pewny)",
        "fr": "« sur » = sur une surface ; attention : « sûr » (avec accent) = certain"
      },
      "confusables": [
        "prep-de",
        "prep-sous"
      ],
      "tags": [
        "lieu"
      ]
    },
    {
      "id": "prep-sous",
      "fr": "sous",
      "pl": "pod",
      "def": "en dessous de",
      "examples": [
        {
          "fr": "Le chien dort sous la table.",
          "pl": "Pies śpi pod stołem."
        }
      ],
      "confusables": [
        "prep-sur"
      ],
      "tags": [
        "lieu"
      ]
    },
    {
      "id": "prep-avec-sans",
      "fr": "avec / sans",
      "pl": "z / bez",
      "def": "avec quelqu’un ou quelque chose / sans : le contraire",
      "examples": [
        {
          "fr": "Un café avec du lait.",
          "pl": "Kawa z mlekiem."
        },
        {
          "fr": "Un café sans sucre.",
          "pl": "Kawa bez cukru."
        }
      ],
      "tip": {
        "pl": "po sans zwykle bez rodzajnika: sans sucre, sans parapluie",
        "fr": "après « sans », en général pas d’article : sans sucre, sans parapluie"
      }
    },
    {
      "id": "prep-chez",
      "fr": "chez",
      "pl": "u (kogoś, w firmie)",
      "def": "dans la maison ou au travail de quelqu’un",
      "examples": [
        {
          "fr": "Je suis chez Pierre.",
          "pl": "Jestem u Pierre'a."
        },
        {
          "fr": "Je vais chez le médecin.",
          "pl": "Idę do lekarza."
        }
      ],
      "tip": {
        "pl": "chez + osoba, nigdy + miejsce: à la boulangerie, nie „chez la boulangerie”",
        "fr": "« chez » + personne, jamais + lieu : à la boulangerie, pas « chez la boulangerie »"
      },
      "confusables": [
        "prep-a"
      ],
      "tags": [
        "lieu"
      ]
    },
    {
      "id": "prep-position",
      "fr": "devant / derrière / entre",
      "pl": "przed / za / między",
      "def": "devant ≠ derrière ; entre = au milieu de deux choses",
      "examples": [
        {
          "fr": "Il est devant la porte.",
          "pl": "On jest przed drzwiami."
        },
        {
          "fr": "Le jardin est derrière la maison.",
          "pl": "Ogród jest za domem."
        },
        {
          "fr": "Entre toi et moi.",
          "pl": "Między tobą a mną."
        }
      ],
      "tip": {
        "pl": "derrière ma akcent grave: è",
        "fr": "« derrière » s’écrit avec un accent grave : è"
      },
      "tags": [
        "lieu"
      ]
    },
    {
      "id": "prep-pendant-depuis",
      "fr": "pendant / depuis",
      "pl": "przez (zakończone) / od (trwa nadal)",
      "def": "pendant = durée terminée ; depuis = action qui continue maintenant",
      "examples": [
        {
          "fr": "J'ai dormi pendant deux heures.",
          "pl": "Spałem przez dwie godziny."
        },
        {
          "fr": "J'habite ici depuis 2020.",
          "pl": "Mieszkam tu od 2020."
        }
      ],
      "tip": {
        "pl": "depuis = trwa do teraz; pendant = zakończone; en = ile zajęło wykonanie",
        "fr": "« depuis » = ça continue maintenant ; « pendant » = c’est fini ; « en » = temps nécessaire pour faire quelque chose"
      },
      "confusables": [
        "prep-dans",
        "prep-en",
        "prep-pour"
      ],
      "tags": [
        "temps"
      ]
    }
  ],
