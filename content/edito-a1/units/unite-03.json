      "tip": {
        "pl": "nieregularne: vous faites (nie « faisez »), ils font, ils vont (nie « allent »)",
        "fr": "irréguliers : vous faites (pas « faisez »), ils font, ils vont (pas « allent »)"
      },
      "tags": ["grammaire"]
    },
