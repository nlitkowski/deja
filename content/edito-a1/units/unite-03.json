{
  "id": "unite-03",
  "title": "Unité 3 · Qu'est-ce qu'on mange ?",
  "icon": "🥖",
  "entries": [
    {
      "id": "u03-pluriel",
      "fr": "le pluriel des noms",
      "pl": "liczba mnoga rzeczowników",
      "def": "en général + s ; -eau → -eaux, -al → -aux, -eu → -eux ; -s, -x, -z ne changent pas",
      "examples": [
        { "fr": "une tomate → des tomates", "pl": "pomidor → pomidory" },
        { "fr": "un gâteau → des gâteaux", "pl": "ciastko → ciastka" }
      ],
      "tip": {
        "pl": "zwykle + s; -eau → -eaux, -al → -aux; słowa na -s, -x, -z się nie zmieniają (un prix → des prix)",
        "fr": "en général + s ; -eau → -eaux, -al → -aux ; les mots en -s, -x, -z ne changent pas (un prix → des prix)"
      },
      "tags": ["grammaire"]
    },
    {
      "id": "u03-partitifs",
      "fr": "du, de la, de l', des",
      "pl": "rodzajniki cząstkowe (partitifs)",
      "def": "une quantité non précise : du pain, de la salade, de l'eau, des fruits",
      "examples": [
        { "fr": "Je mange du pain avec de la confiture.", "pl": "Jem chleb z dżemem." },
        { "fr": "Tu veux de l'eau ?", "pl": "Chcesz wody?" }
      ],
      "tip": {
        "pl": "po polsku « jem chleb », po francusku je mange du pain; du (r. m.), de la (r. ż.), de l' (samogłoska), des (l. mn.)",
        "fr": "du (masculin), de la (féminin), de l' (voyelle), des (pluriel) ; après manger, boire, prendre, acheter, vouloir, il y a"
      },
      "confusables": ["u03-aimer-le-manger-du", "u03-quantite", "a1-connecteurs/contr-du-des"],
      "tags": ["grammaire"]
    },
    {
      "id": "u03-aimer-le-manger-du",
      "fr": "j'aime le café / je bois du café",
      "pl": "lubię kawę / piję kawę",
      "def": "après aimer, adorer, détester : le, la, les ; après manger, boire, acheter : du, de la, des",
      "examples": [
        { "fr": "J'aime le fromage, alors j'achète du fromage.", "pl": "Lubię ser, więc kupuję ser." },
        { "fr": "Je n'aime pas le poisson.", "pl": "Nie lubię ryb." }
      ],
      "tip": {
        "pl": "upodobanie (aimer, adorer, détester) → le, la, les; jedzenie, picie, kupowanie trochę czegoś → du, de la, des",
        "fr": "le goût (aimer, adorer, détester) → le, la, les ; une quantité qu'on mange, boit, achète → du, de la, des"
      },
      "confusables": ["u03-partitifs", "u02-un-ou-le"],
      "tags": ["grammaire"]
    },
    {
      "id": "u03-quantite",
      "fr": "beaucoup de, un kilo de, pas de…",
      "pl": "wyrażenia ilości + de",
      "def": "après une quantité : seulement de ou d', sans article : un kilo de pommes, pas de lait",
      "examples": [
        { "fr": "Je voudrais un kilo de tomates.", "pl": "Poproszę kilogram pomidorów." },
        { "fr": "Il n'y a pas de lait.", "pl": "Nie ma mleka." }
      ],
      "tip": {
        "pl": "po ilości samo de / d', bez rodzajnika: beaucoup de pommes (nie « beaucoup des pommes »)",
        "fr": "après une quantité, seulement de / d' : beaucoup de pommes, pas « beaucoup des pommes »"
      },
      "confusables": ["u03-partitifs", "u02-negation-de"],
      "tags": ["grammaire"]
    },
    {
      "id": "u03-verbes-ir",
      "fr": "choisir, finir",
      "pl": "wybierać, kończyć (czasowniki na -ir)",
      "def": "je finis, tu finis, il finit, nous finissons, vous finissez, ils finissent",
      "examples": [
        { "fr": "Je choisis la tarte.", "pl": "Wybieram tartę." },
        { "fr": "Nous finissons à neuf heures.", "pl": "Kończymy o dziewiątej." }
      ],
      "tip": {
        "pl": "końcówki -is, -is, -it, -issons, -issez, -issent; w liczbie mnogiej pojawia się -iss-",
        "fr": "finales -is, -is, -it, -issons, -issez, -issent ; au pluriel, on ajoute -iss-"
      },
      "tags": ["grammaire"]
    },
    {
      "id": "u03-acheter-payer-manger",
      "fr": "acheter, payer, manger",
      "pl": "kupować, płacić, jeść",
      "def": "j'achète, nous achetons ; je paie, nous payons ; je mange, nous mangeons",
      "examples": [
        { "fr": "Tu achètes du pain ?", "pl": "Kupujesz chleb?" },
        { "fr": "Nous mangeons au restaurant.", "pl": "Jemy w restauracji." }
      ],
      "tip": {
        "pl": "acheter: e → è (j'achète); payer: y → i (je paie, można też je paye); manger: nous mangeons (z e)",
        "fr": "acheter : e → è (j'achète) ; payer : y → i (je paie, je paye est correct aussi) ; manger : nous mangeons (avec e)"
      },
      "tags": ["grammaire"]
    },
    {
      "id": "u03-aller-faire",
      "fr": "aller, faire",
      "pl": "iść / jechać, robić",
      "def": "je vais, tu vas, il va, nous allons, vous allez, ils vont ; je fais, nous faisons, vous faites, ils font",
      "examples": [
        { "fr": "Je fais les courses au marché.", "pl": "Robię zakupy na targu." },
        { "fr": "Ils vont à la boulangerie.", "pl": "Idą do piekarni." }
