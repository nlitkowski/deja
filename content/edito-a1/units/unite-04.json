    {
      "id": "u04-connecteurs",
      "fr": "pour, parce que, mais, avec, sans",
      "pl": "żeby, bo, ale, z, bez",
      "def": "pour = le but ; parce que = la cause ; mais = l'opposition ; avec = ensemble ; sans = le contraire de avec",
      "examples": [
        { "fr": "Je prends le métro pour aller au travail.", "pl": "Jeżdżę metrem, żeby dostać się do pracy." },
        { "fr": "J'aime mon quartier parce qu'il est calme.", "pl": "Lubię swoją dzielnicę, bo jest spokojna." }
      ],
      "tip": {
        "pl": "przed samogłoską parce qu' (parce qu'il); po sans zwykle bez rodzajnika: sans ticket",
        "fr": "devant une voyelle, parce qu' (parce qu'il) ; après sans, en général pas d'article : sans ticket"
      },
      "tags": ["grammaire"]
    }
  ],
