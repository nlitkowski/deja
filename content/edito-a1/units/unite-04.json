{
  "id": "unite-04",
  "title": "Unité 4 · C'est où ?",
  "icon": "🧭",
  "entries": [
    {
      "id": "u04-cest-ilest",
      "fr": "c'est / il est",
      "pl": "to jest / on jest",
      "def": "c'est + article + nom ; il / elle est + adjectif ou profession",
      "examples": [
        { "fr": "C'est un musée.", "pl": "To jest muzeum." },
        { "fr": "Il est professeur.", "pl": "On jest nauczycielem." }
      ],
      "tip": {
        "pl": "c'est + rodzajnik + rzeczownik; il / elle est + przymiotnik albo zawód bez rodzajnika",
        "fr": "c'est + article + nom ; il / elle est + adjectif ou profession sans article"
      },
      "tags": ["grammaire"]
    },
    {
      "id": "u04-frequence",
      "fr": "toujours / souvent / ne … jamais",
      "pl": "zawsze / często / nigdy",
      "def": "100 % du temps / beaucoup de fois / 0 % du temps",
      "examples": [
        { "fr": "Je prends souvent le bus.", "pl": "Często jeżdżę autobusem." },
        { "fr": "Il ne prend jamais le taxi.", "pl": "On nigdy nie jeździ taksówką." }
      ],
      "tip": {
        "pl": "przysłówek stoi po czasowniku; jamais wymaga ne przed czasownikiem",
        "fr": "l'adverbe se place après le verbe ; jamais demande ne avant le verbe"
      },
      "tags": ["grammaire"]
    },
    {
      "id": "u04-imperatif",
      "fr": "l'impératif",
      "pl": "tryb rozkazujący",
      "def": "pour donner un ordre ou une indication : trois formes (tu, nous, vous), sans sujet",
      "examples": [
        { "fr": "Tournez à gauche.", "pl": "Proszę skręcić w lewo." },
        { "fr": "Prends le bus !", "pl": "Jedź autobusem!" }
      ],
      "tip": {
        "pl": "bez podmiotu; czasowniki na -er i aller tracą -s w formie tu: monte, va",
        "fr": "pas de sujet ; les verbes en -er et aller perdent le -s à la forme tu : monte, va"
      },
      "confusables": ["u04-imperatif-etre-avoir"],
      "tags": ["grammaire"]
    },
    {
      "id": "u04-imperatif-etre-avoir",
      "fr": "sois, soyez / aie, ayez",
      "pl": "bądź, bądźcie / miej, miejcie",
      "def": "l'impératif irrégulier de être et avoir",
      "examples": [
        { "fr": "Sois patient !", "pl": "Bądź cierpliwy!" },
        { "fr": "N'ayez pas peur.", "pl": "Nie bójcie się." }
      ],
      "tip": {
        "pl": "être: sois, soyons, soyez; avoir: aie, ayons, ayez",
        "fr": "être : sois, soyons, soyez ; avoir : aie, ayons, ayez"
      },
      "confusables": ["u04-imperatif"],
      "tags": ["grammaire"]
    },
    {
      "id": "u04-prendre",
      "fr": "prendre",
      "pl": "brać; jechać (środkiem transportu)",
      "def": "je prends, nous prenons, ils prennent",
      "examples": [
        { "fr": "Nous prenons le tramway.", "pl": "Jedziemy tramwajem." },
        { "fr": "Ils prennent un taxi.", "pl": "Biorą taksówkę." }
      ],
      "tip": {
        "pl": "nous prenons (jedno n), ils prennent (dwa n)",
        "fr": "nous prenons (un n), ils prennent (deux n)"
      },
      "tags": ["grammaire"]
    },
    {
      "id": "u04-nombres",
      "fr": "cent, mille, un million",
      "pl": "sto, tysiąc, milion",
      "def": "les nombres de 100 à 1 milliard",
      "examples": [
        { "fr": "deux cents, deux cent cinquante", "pl": "dwieście, dwieście pięćdziesiąt" },
        { "fr": "trois mille", "pl": "trzy tysiące" }
      ],
      "tip": {
        "pl": "cent ma -s tylko na końcu liczby (deux cents); mille nigdy nie ma -s",
        "fr": "cent prend -s seulement à la fin du nombre (deux cents) ; mille ne prend jamais de -s"
      },
      "tags": ["grammaire"]
    },
