{
  "id": "unite-07",
  "title": "Unité 7 · Chez moi !",
  "icon": "🏠",
  "entries": [
    {
      "id": "u07-pc-avoir",
      "fr": "j'ai trouvé, nous avons appelé",
      "pl": "passé composé z avoir (czas przeszły)",
      "def": "une action finie dans le passé : avoir au présent + participe passé ; verbes en -er → -é",
      "examples": [
        { "fr": "Hier, j'ai trouvé un appartement.", "pl": "Wczoraj znalazłem mieszkanie." },
        { "fr": "Nous avons appelé le plombier.", "pl": "Zadzwoniliśmy po hydraulika." }
      ],
      "tip": {
        "pl": "ai, as, a, avons, avez, ont + imiesłów; czasowniki na -er: -er → -é (trouver → trouvé)",
        "fr": "ai, as, a, avons, avez, ont + participe passé ; verbes en -er : -er → -é (trouver → trouvé)"
      },
      "confusables": ["u07-participes"],
      "tags": ["grammaire"]
    },
    {
      "id": "u07-participes",
      "fr": "fait, pris, mis, vu, eu, été",
      "pl": "nieregularne imiesłowy przeszłe",
      "def": "faire → fait, prendre → pris, mettre → mis, voir → vu, avoir → eu, être → été",
      "examples": [
        { "fr": "Les voisins ont fait une fête.", "pl": "Sąsiedzi zrobili imprezę." },
        { "fr": "J'ai vu un bel appartement.", "pl": "Widziałem ładne mieszkanie." }
      ],
      "tip": {
        "pl": "faire → fait, prendre → pris, mettre → mis, voir → vu, avoir → eu, être → été",
        "fr": "faire → fait, prendre → pris, mettre → mis, voir → vu, avoir → eu, être → été"
      },
      "confusables": ["u07-pc-avoir"],
      "tags": ["grammaire"]
    },
    {
      "id": "u07-pc-negation",
      "fr": "je n'ai pas trouvé",
      "pl": "przeczenie w passé composé",
      "def": "la négation est autour de avoir : ne (n') + avoir + pas + participe passé",
      "examples": [
        { "fr": "Tu n'as pas fermé la porte !", "pl": "Nie zamknąłeś drzwi!" },
        { "fr": "Ils n'ont pas payé le loyer.", "pl": "Nie zapłacili czynszu." }
      ],
      "tip": {
        "pl": "n'ai pas, n'as pas, n'a pas, n'avons pas, n'avez pas, n'ont pas + imiesłów (nie: je n'ai réparé pas)",
        "fr": "n'ai pas, n'as pas, n'a pas, n'avons pas, n'avez pas, n'ont pas + participe (pas « je n'ai réparé pas »)"
      },
      "tags": ["grammaire"]
    },
    {
      "id": "u07-temps-passe",
      "fr": "hier, la semaine dernière, il y a deux jours",
      "pl": "wyrażenia czasu przeszłego",
      "def": "pour dire quand une action passée a eu lieu",
      "examples": [
        { "fr": "La semaine dernière, nous avons acheté un canapé.", "pl": "W zeszłym tygodniu kupiliśmy kanapę." },
        { "fr": "J'ai visité l'appartement il y a deux jours.", "pl": "Obejrzałem mieszkanie dwa dni temu." }
      ],
      "tip": {
        "pl": "hier = wczoraj; dernier / dernière = zeszły (le mois dernier, la semaine dernière); il y a + czas = … temu",
        "fr": "hier = le jour avant aujourd'hui ; dernier / dernière (le mois dernier, la semaine dernière) ; il y a + durée"
      },
      "tags": ["grammaire"]
    },
    {
      "id": "u07-lieu-maison",
      "fr": "au fond de, à gauche de, à droite de, au premier étage",
      "pl": "w głębi, na lewo od, na prawo od, na pierwszym piętrze",
      "def": "pour situer une pièce dans un logement ou un immeuble",
      "examples": [
        { "fr": "La salle de bains est au fond du couloir.", "pl": "Łazienka jest na końcu korytarza." },
        { "fr": "J'habite au premier étage.", "pl": "Mieszkam na pierwszym piętrze." }
      ],
      "tip": {
        "pl": "piętro: au premier étage, au rez-de-chaussée (nie sur); de + le = du: au fond du couloir",
        "fr": "étage : au premier étage, au rez-de-chaussée (pas sur) ; de + le = du : au fond du couloir"
      },
      "confusables": ["a1-connecteurs/expr-a-cote-de", "a1-connecteurs/expr-en-face-de"],
      "tags": ["grammaire"]
    },
    {
      "id": "u07-il-faut",
      "fr": "il faut / il ne faut pas + infinitif",
      "pl": "trzeba / nie wolno",
      "def": "il faut = c'est nécessaire ; il ne faut pas = ce n'est pas permis ; le sujet est toujours il",
      "examples": [
        { "fr": "Il faut fermer la porte.", "pl": "Trzeba zamykać drzwi." },
        { "fr": "Il ne faut pas fumer dans l'escalier.", "pl": "Nie wolno palić na klatce schodowej." }
      ],
      "tip": {
        "pl": "zawsze il faut (nigdy je faut) + bezokolicznik; przeczenie: il ne faut pas",
        "fr": "toujours il faut (jamais « je faut ») + infinitif ; négation : il ne faut pas"
      },
      "confusables": ["u07-interdiction"],
      "tags": ["grammaire"]
    },
    {
      "id": "u07-interdiction",
      "fr": "il est interdit de / défense de / ne pas + infinitif",
      "pl": "zakaz",
      "def": "pour dire que ce n'est pas permis, souvent dans un règlement ou sur un panneau",
      "examples": [
        { "fr": "Il est interdit de fumer.", "pl": "Palenie jest zabronione." },
        { "fr": "Ne pas jeter de papiers.", "pl": "Nie wyrzucać papierów." }
      ],
      "tip": {
        "pl": "il est interdit de / défense de + bezokolicznik; przy bezokoliczniku ne pas stoją razem: ne pas fumer",
        "fr": "il est interdit de / défense de + infinitif ; devant l'infinitif, ne pas sont ensemble : ne pas fumer"
      },
      "confusables": ["u07-il-faut"],
      "tags": ["grammaire"]
    },
    {
      "id": "u07-cod",
      "fr": "le, la, l', les (COD)",
      "pl": "go, ją, je (zaimki dopełnienia bliższego)",
      "def": "le pronom remplace un nom après le verbe, sans préposition ; il se place avant le verbe",
      "examples": [
        { "fr": "Tu connais la gardienne ? — Oui, je la connais.", "pl": "Znasz dozorczynię? — Tak, znam ją." },
        { "fr": "Les poubelles ? On les sort le mardi.", "pl": "Śmieci? Wystawiamy je we wtorki." }
      ],
      "tip": {
        "pl": "le (r. męski), la (r. żeński), l' (przed samogłoską), les (lm); przed czasownikiem; rodzaj jak we francuskim słowie",
        "fr": "le (masculin), la (féminin), l' (devant une voyelle), les (pluriel) ; avant le verbe ; le genre vient du nom français"
      },
      "tags": ["grammaire"]
    },
    {
      "id": "u07-connaitre",
      "fr": "connaître",
      "pl": "znać",
      "def": "je connais, il connaît, nous connaissons, ils connaissent + une personne, un lieu",
      "examples": [
        { "fr": "Vous connaissez vos voisins ?", "pl": "Znacie swoich sąsiadów?" },
        { "fr": "Elle connaît un bon électricien.", "pl": "Ona zna dobrego elektryka." }
      ],
      "tip": {
        "pl": "il connaît z î; w liczbie mnogiej -ss-: nous connaissons, ils connaissent",
        "fr": "il connaît avec î ; au pluriel -ss- : nous connaissons, ils connaissent"
      },
      "tags": ["grammaire"]
    },
    { "id": "u07-chambre", "fr": "une chambre", "pl": "sypialnia, pokój", "def": "la pièce où on dort", "examples": [{ "fr": "Ma chambre est petite mais calme.", "pl": "Mój pokój jest mały, ale cichy." }], "tags": ["vocabulaire"] },
