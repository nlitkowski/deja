    { "id": "u09-ile", "fr": "une île", "pl": "wyspa", "def": "une terre entourée d'eau", "examples": [{ "fr": "La Corse est une île.", "pl": "Korsyka jest wyspą." }], "tags": ["vocabulaire"] },
    { "id": "u09-camping", "fr": "un camping", "pl": "kemping, pole namiotowe", "def": "un terrain où on dort sous la tente", "examples": [{ "fr": "Le camping est près du lac.", "pl": "Kemping jest blisko jeziora." }], "tags": ["vocabulaire"] },
