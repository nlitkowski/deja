{
  "id": "unite-09",
  "title": "Unité 9 · Bonnes vacances !",
  "icon": "🌴",
  "entries": [
    {
      "id": "u09-comparatif",
      "fr": "plus / moins / aussi … que",
      "pl": "bardziej / mniej / tak samo … niż (jak)",
      "def": "pour comparer : plus (+), moins (−), aussi (=) + adjectif + que",
      "examples": [
        { "fr": "Le train est plus rapide que le bus.", "pl": "Pociąg jest szybszy niż autobus." },
        { "fr": "Le camping est moins cher que l'hôtel.", "pl": "Kemping jest tańszy niż hotel." }
      ],
      "tip": {
        "pl": "przymiotnik zgadza się z rzeczownikiem; przed samogłoską que → qu'",
        "fr": "l'adjectif s'accorde avec le nom ; devant une voyelle, que → qu'"
      },
      "confusables": ["u09-meilleur"],
      "tags": ["grammaire"]
    },
    {
      "id": "u09-meilleur",
      "fr": "meilleur(e)(s)",
      "pl": "lepszy",
      "def": "le comparatif de bon : on ne dit pas « plus bon »",
      "examples": [
        { "fr": "Ce restaurant est meilleur que l'autre.", "pl": "Ta restauracja jest lepsza niż tamta." },
        { "fr": "La cuisine italienne est meilleure que la cuisine allemande.", "pl": "Kuchnia włoska jest lepsza niż niemiecka." }
      ],
      "tip": {
        "pl": "bon → meilleur (nie „plus bon”); odmiana: meilleur, meilleure, meilleurs, meilleures",
        "fr": "bon → meilleur (pas « plus bon ») ; accord : meilleur, meilleure, meilleurs, meilleures"
      },
      "confusables": ["u09-comparatif"],
      "tags": ["grammaire"]
    },
    {
      "id": "u09-pc-etre-voyage",
      "fr": "je suis parti(e), nous sommes arrivé(e)s",
      "pl": "passé composé z être: czasowniki podróży",
      "def": "aller, venir, partir, arriver, rester, rentrer, sortir, monter, descendre, tomber : être + participe accordé avec le sujet",
      "examples": [
        { "fr": "Je suis allée en Italie.", "pl": "Pojechałam do Włoch." },
        { "fr": "Nous sommes partis le 2 août.", "pl": "Wyjechaliśmy 2 sierpnia." }
      ],
      "tip": {
        "pl": "imiesłów zgadza się z podmiotem: kobieta pisze je suis partie, grupa: nous sommes partis",
        "fr": "le participe s'accorde avec le sujet : une femme écrit je suis partie, un groupe : nous sommes partis"
      },
      "confusables": ["u08-pc-etre"],
      "tags": ["grammaire"]
    },
    {
      "id": "u09-cetait",
      "fr": "c'était / il y avait / il faisait",
      "pl": "to było / był(o), były / była (pogoda)",
      "def": "l'imparfait pour décrire dans le passé : une impression, ce qu'on voyait, le temps",
      "examples": [
        { "fr": "C'était très joli !", "pl": "Było bardzo ładnie!" },
        { "fr": "Il faisait beau et il y avait du soleil.", "pl": "Była ładna pogoda i świeciło słońce." }
      ],
      "tip": {
        "pl": "c'était + przymiotnik (wrażenie), il y avait + rzeczownik, il faisait + pogoda",
        "fr": "c'était + adjectif (impression), il y avait + nom, il faisait + météo"
      },
      "tags": ["grammaire"]
    },
    {
      "id": "u09-preferer",
      "fr": "préférer / aimer mieux",
      "pl": "woleć",
      "def": "je préfère, nous préférons + nom ou infinitif, sans préposition",
      "examples": [
        { "fr": "Je préfère la mer.", "pl": "Wolę morze." },
        { "fr": "Nous préférons la campagne.", "pl": "Wolimy wieś." }
      ],
      "tip": {
        "pl": "è w je/tu/il/ils (préfère, préfèrent), é w nous/vous (préférons, préférez)",
        "fr": "è pour je, tu, il, ils (préfère, préfèrent), é pour nous, vous (préférons, préférez)"
      },
      "tags": ["grammaire"]
    },
    {
      "id": "u09-de-du-des-pays",
      "fr": "de / d' / du / des + ville, pays",
      "pl": "z (skąd: miasto, kraj)",
      "def": "venir, arriver, revenir + de (ville, pays féminin), d' (devant une voyelle), du (pays masculin), des (pays pluriel)",
      "examples": [
        { "fr": "Je viens de Pologne.", "pl": "Pochodzę z Polski." },
        { "fr": "Il revient du Japon.", "pl": "On wraca z Japonii." },
        { "fr": "Nous arrivons des États-Unis.", "pl": "Przyjeżdżamy ze Stanów Zjednoczonych." }
      ],
      "tip": {
        "pl": "jak à / au / en / aux: en France → de France, au Japon → du Japon, aux États-Unis → des États-Unis, à Paris → de Paris",
        "fr": "comme à / au / en / aux : en France → de France, au Japon → du Japon, aux États-Unis → des États-Unis, à Paris → de Paris"
      },
      "tags": ["grammaire"]
    },
