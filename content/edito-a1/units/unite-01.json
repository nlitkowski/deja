{
  "id": "unite-01",
  "title": "Unité 1 · Je suis…",
  "icon": "👋",
  "entries": [
    {
      "id": "u01-etre",
      "fr": "être",
      "pl": "być",
      "def": "je suis, tu es, il est, nous sommes, vous êtes, ils sont",
      "examples": [
        { "fr": "Je suis étudiante.", "pl": "Jestem studentką." },
        { "fr": "Nous sommes de Cracovie.", "pl": "Jesteśmy z Krakowa." }
      ],
      "tip": {
        "pl": "être: narodowość, zawód, pochodzenie; uwaga: ils sont [s] ≠ ils ont [z]",
        "fr": "être : la nationalité, la profession, l'origine ; attention : ils sont [s] ≠ ils ont [z]"
      },
      "confusables": ["u01-avoir"],
      "tags": ["grammaire"]
    },
    {
      "id": "u01-avoir",
      "fr": "avoir",
      "pl": "mieć",
      "def": "j'ai, tu as, il a, nous avons, vous avez, ils ont",
      "examples": [
        { "fr": "J'ai vingt ans.", "pl": "Mam dwadzieścia lat." },
        { "fr": "Ils ont un chat.", "pl": "Oni mają kota." }
      ],
      "tip": {
        "pl": "wiek wyrażamy przez avoir + ans: j'ai vingt ans (nie « je suis »); je → j' przed samogłoską",
        "fr": "l'âge : avoir + ans : j'ai vingt ans ; je → j' devant une voyelle"
      },
      "confusables": ["u01-etre"],
      "tags": ["grammaire"]
    },
    {
      "id": "u01-sappeler",
      "fr": "s'appeler",
      "pl": "nazywać się",
      "def": "je m'appelle, tu t'appelles, il s'appelle, nous nous appelons, vous vous appelez, ils s'appellent",
      "examples": [
        { "fr": "Je m'appelle Marta.", "pl": "Nazywam się Marta." },
        { "fr": "Vous vous appelez comment ?", "pl": "Jak się pan nazywa?" }
      ],
      "tip": {
        "pl": "zawsze z zaimkiem (me, te, se…); dwa l przy je, tu, il, ils, jedno l przy nous i vous",
        "fr": "toujours avec le pronom (me, te, se…) ; deux l avec je, tu, il, ils, un l avec nous et vous"
      },
      "tags": ["grammaire"]
    },
    {
      "id": "u01-parler",
      "fr": "parler",
      "pl": "mówić",
      "def": "je parle, tu parles, il parle, nous parlons, vous parlez, ils parlent",
      "examples": [
        { "fr": "Je parle polonais et anglais.", "pl": "Mówię po polsku i po angielsku." },
        { "fr": "Vous parlez français ?", "pl": "Czy mówi pan po francusku?" }
      ],
      "tip": {
        "pl": "regularny czasownik na -er; język małą literą i zwykle bez rodzajnika: je parle polonais",
        "fr": "verbe en -er régulier ; la langue avec une minuscule, en général sans article : je parle polonais"
      },
      "tags": ["grammaire"]
    },
    {
      "id": "u01-nationalites",
      "fr": "polonais / polonaise",
      "pl": "przymiotniki narodowości (rodzaj i liczba)",
      "def": "féminin : + e (polonaise), -ien → -ienne (italienne) ; pluriel : + s (allemands)",
      "examples": [
        { "fr": "Marek est polonais, sa femme est française.", "pl": "Marek jest Polakiem, jego żona jest Francuzką." },
        { "fr": "Elles sont italiennes.", "pl": "One są Włoszkami." }
      ],
      "tip": {
        "pl": "rodzaj żeński: + e, -ien → -ienne; zakończenie -e bez zmian (belge); małą literą: elle est polonaise",
        "fr": "féminin : + e, -ien → -ienne ; -e ne change pas (belge) ; avec une minuscule : elle est polonaise"
      },
      "tags": ["grammaire"]
    },
    {
      "id": "u01-articles-definis",
      "fr": "le, la, l', les",
      "pl": "rodzajniki określone",
      "def": "le + masculin, la + féminin, l' + voyelle ou h muet, les + pluriel",
      "examples": [
        { "fr": "J'aime la musique et le cinéma.", "pl": "Lubię muzykę i kino." },
        { "fr": "L'Italie est un beau pays.", "pl": "Włochy to piękny kraj." }
      ],
      "tip": {
        "pl": "po polsku nie ma rodzajników, po francusku rzeczownik prawie zawsze go ma; l' przed samogłoską: l'amie",
        "fr": "le nom a presque toujours un article ; l' devant une voyelle : l'amie, pas « la amie »"
      },
      "confusables": ["u02-articles-indefinis"],
      "tags": ["grammaire"]
    },
    {
      "id": "u01-quel",
      "fr": "quel, quelle, quels, quelles",
      "pl": "jaki, jaka, jakie (pytanie)",
      "def": "quel s'accorde avec le nom : quel âge, quelle nationalité, quels sports, quelles langues",
      "examples": [
        { "fr": "Quelle est votre adresse ?", "pl": "Jaki jest pana adres?" },
        { "fr": "Tu as quel âge ?", "pl": "Ile masz lat?" }
      ],
      "tip": {
        "pl": "forma zgadza się z rzeczownikiem; wszystkie cztery brzmią tak samo; rzeczowniki na -té są żeńskie: quelle nationalité",
        "fr": "accord avec le nom ; les quatre formes ont le même son ; les noms en -té sont féminins : quelle nationalité"
      },
      "tags": ["grammaire"]
    },
    { "id": "u01-prenom", "fr": "un prénom", "pl": "imię", "def": "le nom personnel : Anna, Paul, Marc…", "examples": [{ "fr": "Mon prénom est Anna.", "pl": "Mam na imię Anna." }], "tags": ["vocabulaire"] },
    { "id": "u01-nom", "fr": "un nom (de famille)", "pl": "nazwisko", "def": "le nom de toute la famille : Dupont, Kowalski…", "examples": [{ "fr": "Quel est votre nom de famille ?", "pl": "Jak brzmi pana nazwisko?" }], "tags": ["vocabulaire"] },
    { "id": "u01-adresse", "fr": "une adresse", "pl": "adres", "def": "la rue, le numéro et la ville où on habite", "examples": [{ "fr": "Quelle est ton adresse ?", "pl": "Jaki jest twój adres?" }], "tags": ["vocabulaire"] },
