    { "id": "u01-nationalite", "fr": "une nationalité", "pl": "narodowość", "def": "on est polonais, français, italien…", "examples": [{ "fr": "Quelle est votre nationalité ?", "pl": "Jakiej jest pani narodowości?" }], "tags": ["vocabulaire"] },
    { "id": "u01-langue", "fr": "une langue", "pl": "język", "def": "le français, l'anglais, le polonais…", "examples": [{ "fr": "Je parle trois langues.", "pl": "Mówię trzema językami." }], "tags": ["vocabulaire"] },
    { "id": "u01-profession", "fr": "une profession", "pl": "zawód", "def": "le travail de quelqu'un : médecin, professeur…", "examples": [{ "fr": "Quelle est votre profession ?", "pl": "Jaki jest pana zawód?" }], "tags": ["vocabulaire"], "deprecated": true },
    { "id": "u01-numero", "fr": "un numéro de téléphone", "pl": "numer telefonu", "def": "les chiffres pour appeler quelqu'un", "examples": [{ "fr": "Quel est ton numéro de téléphone ?", "pl": "Jaki jest twój numer telefonu?" }], "tags": ["vocabulaire"] },
