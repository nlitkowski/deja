      "examples": [{ "fr": "Lieu de naissance : Gdańsk, Pologne.", "pl": "Miejsce urodzenia: Gdańsk, Polska." }],
      "tip": {
        "pl": "rodzaj męski: le lieu; lieu de naissance = miasto, date de naissance = dzień",
