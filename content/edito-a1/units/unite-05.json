{
  "id": "unite-05",
  "title": "Unité 5 · C'est tendance !",
  "icon": "👗",
  "entries": [
    {
      "id": "u05-adj-feminin",
      "fr": "noir → noire, sportif → sportive",
      "pl": "rodzaj żeński przymiotników",
      "def": "au féminin, l'adjectif prend en général un -e ; certains changent davantage",
      "examples": [
        { "fr": "J'ai une chemise blanche et un pantalon blanc.", "pl": "Mam białą koszulę i białe spodnie." },
        { "fr": "Elle porte une jupe longue.", "pl": "Ona nosi długą spódnicę." }
      ],
      "tip": {
        "pl": "zwykle + e; -f → -ve, -x → -se, -el → -elle, -on → -onne, -ien → -ienne; blanc → blanche, long → longue",
        "fr": "en général + e ; -f → -ve, -x → -se, -el → -elle, -on → -onne, -ien → -ienne ; blanc → blanche, long → longue"
      },
      "confusables": ["u05-beau-nouveau-vieux"],
      "tags": ["grammaire"]
    },
    {
      "id": "u05-adj-pluriel",
      "fr": "noir → noirs, beau → beaux",
      "pl": "liczba mnoga przymiotników",
      "def": "au pluriel, l'adjectif prend en général un -s",
      "examples": [
        { "fr": "Elle a des bottes noires.", "pl": "Ona ma czarne kozaki." },
        { "fr": "Ce sont des sacs originaux.", "pl": "To oryginalne torby." }
      ],
      "tip": {
        "pl": "zwykle + s; -eau → -eaux, -al → -aux; -s i -x się nie zmieniają; marron i orange są nieodmienne",
        "fr": "en général + s ; -eau → -eaux, -al → -aux ; -s et -x ne changent pas ; marron et orange sont invariables"
      },
      "tags": ["grammaire"]
    },
    {
      "id": "u05-beau-nouveau-vieux",
      "fr": "beau / bel / belle, nouveau / nouvel / nouvelle, vieux / vieil / vieille",
      "pl": "ładny, nowy, stary – formy szczególne",
      "def": "devant un nom masculin qui commence par une voyelle : bel, nouvel, vieil",
      "examples": [
        { "fr": "Ils ont un bel appartement.", "pl": "Mają piękne mieszkanie." },
        { "fr": "C'est une nouvelle montre.", "pl": "To nowy zegarek." }
      ],
      "tip": {
        "pl": "rodzaj męski przed samogłoską lub niemym h: bel, nouvel, vieil; rodzaj żeński: belle, nouvelle, vieille",
        "fr": "masculin devant une voyelle ou un h muet : bel, nouvel, vieil ; féminin : belle, nouvelle, vieille"
      },
      "confusables": ["u05-adj-feminin"],
      "tags": ["grammaire"]
    },
    {
      "id": "u05-adj-place",
      "fr": "une robe rouge / un petit sac",
      "pl": "miejsce przymiotnika",
      "def": "en général après le nom ; quelques adjectifs courts avant le nom (beau, joli, grand, petit, bon, vieux, nouveau…)",
      "examples": [
        { "fr": "C'est un petit sac noir.", "pl": "To mała czarna torebka." },
        { "fr": "Elle a de belles chaussures.", "pl": "Ona ma ładne buty." }
      ],
      "tip": {
        "pl": "kolory zawsze po rzeczowniku; przymiotnik w lm przed rzeczownikiem: des → de (de belles chaussures)",
        "fr": "les couleurs toujours après le nom ; adjectif pluriel avant le nom : des → de (de belles chaussures)"
      },
      "tags": ["grammaire"]
    },
    {
      "id": "u05-demonstratif",
      "fr": "ce / cet / cette / ces",
      "pl": "ten / ta / te",
      "def": "pour montrer une chose précise",
      "examples": [
        { "fr": "Combien coûte ce chapeau ?", "pl": "Ile kosztuje ten kapelusz?" },
        { "fr": "Cet été, je vais acheter des sandales.", "pl": "Tego lata kupię sobie sandały." }
      ],
      "tip": {
        "pl": "ce + rodzaj męski; cet + rodzaj męski przed samogłoską lub niemym h; cette + rodzaj żeński; ces + liczba mnoga",
        "fr": "ce + masculin ; cet + masculin devant une voyelle ou un h muet ; cette + féminin ; ces + pluriel"
      },
      "tags": ["grammaire"]
    },
    {
      "id": "u05-futur-proche",
      "fr": "aller + infinitif",
      "pl": "czas przyszły bliski",
      "def": "une action proche dans le futur : je vais acheter",
      "examples": [
        { "fr": "Demain, il va faire beau.", "pl": "Jutro będzie ładna pogoda." },
        { "fr": "Ce soir, nous allons sortir.", "pl": "Dziś wieczorem wychodzimy." }
      ],
      "tip": {
        "pl": "aller w czasie teraźniejszym (vais, vas, va, allons, allez, vont) + bezokolicznik, bez przyimka",
        "fr": "aller au présent (vais, vas, va, allons, allez, vont) + infinitif, sans préposition"
      },
      "confusables": ["u06-passe-recent"],
      "tags": ["grammaire"]
    },
    {
      "id": "u05-vendre",
      "fr": "vendre",
      "pl": "sprzedawać",
      "def": "je vends, il vend, nous vendons, ils vendent (comme attendre, répondre, entendre)",
      "examples": [
        { "fr": "Ils vendent des vêtements d'occasion.", "pl": "Oni sprzedają używane ubrania." },
        { "fr": "J'attends le bus.", "pl": "Czekam na autobus." }
      ],
      "tip": {
        "pl": "il vend – bez dodatkowego -t; tak samo attendre, répondre, entendre",
        "fr": "il vend – pas de -t en plus ; même modèle : attendre, répondre, entendre"
      },
      "tags": ["grammaire"]
    },
    {
      "id": "u05-mettre",
      "fr": "mettre",
      "pl": "kłaść; zakładać (ubranie)",
      "def": "je mets, il met, nous mettons, ils mettent",
      "examples": [
        { "fr": "Qu'est-ce que tu mets ce soir ?", "pl": "Co zakładasz dziś wieczorem?" },
        { "fr": "Ils mettent leurs manteaux.", "pl": "Zakładają płaszcze." }
      ],
      "tip": {
        "pl": "jedno t w liczbie pojedynczej (je mets, il met), dwa t w liczbie mnogiej (nous mettons, ils mettent)",
        "fr": "un t au singulier (je mets, il met), deux t au pluriel (nous mettons, ils mettent)"
      },
      "tags": ["grammaire"]
    },
    {
      "id": "u05-venir",
      "fr": "venir",
      "pl": "przychodzić, przyjeżdżać",
      "def": "je viens, il vient, nous venons, ils viennent ; venir de = l'origine",
      "examples": [
        { "fr": "Je viens de Pologne.", "pl": "Pochodzę z Polski." },
        { "fr": "Vous venez avec nous ?", "pl": "Idziecie z nami?" }
      ],
      "tip": {
        "pl": "il vient (z -t), nous venons, ils viennent (dwa n)",
        "fr": "il vient (avec -t), nous venons, ils viennent (deux n)"
      },
      "tags": ["grammaire"]
    },
    { "id": "u05-pantalon", "fr": "un pantalon", "pl": "spodnie", "def": "vêtement long pour les jambes", "examples": [{ "fr": "Mon pantalon est noir.", "pl": "Moje spodnie są czarne." }], "tags": ["vocabulaire"] },
    { "id": "u05-jupe", "fr": "une jupe", "pl": "spódnica", "def": "vêtement de femme, de la taille aux genoux ou plus bas", "examples": [{ "fr": "Elle porte une jupe courte.", "pl": "Ona nosi krótką spódnicę." }], "tags": ["vocabulaire"] },
    { "id": "u05-robe", "fr": "une robe", "pl": "sukienka", "def": "vêtement de femme d'une seule pièce", "examples": [{ "fr": "Cette robe te va très bien.", "pl": "Bardzo ci dobrze w tej sukience." }], "tags": ["vocabulaire"] },
    { "id": "u05-chemise", "fr": "une chemise", "pl": "koszula", "def": "vêtement avec des boutons et un col", "examples": [{ "fr": "Il porte une chemise bleue.", "pl": "On ma na sobie niebieską koszulę." }], "tags": ["vocabulaire"] },
    { "id": "u05-pull", "fr": "un pull", "pl": "sweter", "def": "vêtement chaud pour le haut du corps", "examples": [{ "fr": "J'ai un pull en laine.", "pl": "Mam wełniany sweter." }], "tags": ["vocabulaire"] },
    { "id": "u05-manteau", "fr": "un manteau", "pl": "płaszcz", "def": "vêtement chaud qu'on met pour sortir en hiver", "examples": [{ "fr": "Combien coûte ce manteau ?", "pl": "Ile kosztuje ten płaszcz?" }], "tags": ["vocabulaire"] },
    { "id": "u05-chaussures", "fr": "des chaussures", "pl": "buty", "def": "on les met aux pieds", "examples": [{ "fr": "Ces chaussures sont trop petites.", "pl": "Te buty są za małe." }], "tags": ["vocabulaire"] },
    { "id": "u05-echarpe", "fr": "une écharpe", "pl": "szalik", "def": "on la met autour du cou quand il fait froid", "examples": [{ "fr": "Prends ton écharpe, il fait froid !", "pl": "Weź szalik, jest zimno!" }], "tags": ["vocabulaire"] },
    { "id": "u05-parapluie", "fr": "un parapluie", "pl": "parasol (od deszczu)", "def": "il protège de la pluie", "examples": [{ "fr": "Il pleut, j'ouvre mon parapluie.", "pl": "Pada deszcz, otwieram parasol." }], "tags": ["vocabulaire"] },
    { "id": "u05-portefeuille", "fr": "un portefeuille", "pl": "portfel", "def": "petit objet pour l'argent et les cartes", "examples": [{ "fr": "Mon portefeuille est dans mon sac.", "pl": "Mój portfel jest w torebce." }], "tags": ["vocabulaire"] }
  ],
