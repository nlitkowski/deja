{
  "id": "unite-02",
  "title": "Unité 2 · Près de moi",
  "icon": "👨‍👩‍👧",
  "entries": [
    {
      "id": "u02-articles-indefinis",
      "fr": "un, une, des",
      "pl": "rodzajniki nieokreślone",
      "def": "pour une chose nouvelle ou pas précise : un frère, une sœur, des enfants",
      "examples": [
        { "fr": "J'ai un frère et une sœur.", "pl": "Mam brata i siostrę." },
        { "fr": "Il y a des cafés dans ma rue.", "pl": "Na mojej ulicy są kawiarnie." }
      ],
      "tip": {
        "pl": "un (r. męski), une (r. żeński), des (liczba mnoga); używamy, gdy mówimy o czymś nowym, jednym z wielu",
        "fr": "un (masculin), une (féminin), des (pluriel) ; pour une chose nouvelle, une parmi d'autres"
      },
      "confusables": ["u02-un-ou-le", "u01-articles-definis"],
      "tags": ["grammaire"]
    },
    {
      "id": "u02-un-ou-le",
      "fr": "un ou le ?",
      "pl": "rodzajnik nieokreślony czy określony?",
      "def": "un, une, des : chose nouvelle ; le, la, les : chose connue, unique, ou après aimer, adorer, détester, préférer",
      "examples": [
        { "fr": "Il y a un parc. Le parc est grand.", "pl": "Jest park. Ten park jest duży." },
        { "fr": "Elle adore les chats.", "pl": "Ona uwielbia koty." }
      ],
      "tip": {
        "pl": "po czasownikach upodobań (aimer, adorer, détester, préférer) zawsze le, la, les: j'aime le sport",
        "fr": "après les verbes de goût (aimer, adorer, détester, préférer), toujours le, la, les : j'aime le sport"
      },
      "confusables": ["u02-articles-indefinis", "u03-aimer-le-manger-du"],
      "tags": ["grammaire"]
    },
    {
      "id": "u02-negation-de",
      "fr": "pas de / pas d'",
      "pl": "nie mam (żadnego) …",
      "def": "après la négation, un, une, des deviennent de ou d'",
      "examples": [
        { "fr": "Je n'ai pas de frère.", "pl": "Nie mam brata." },
        { "fr": "Il n'a pas d'enfants.", "pl": "On nie ma dzieci." }
      ],
      "tip": {
        "pl": "un / une / des → de po przeczeniu; przed samogłoską d'",
        "fr": "un / une / des → de après la négation ; d' devant une voyelle"
      },
      "confusables": ["u03-quantite"],
      "tags": ["grammaire"]
    },
    {
      "id": "u02-verbes-er",
      "fr": "les verbes en -er",
      "pl": "czasowniki na -er (czas teraźniejszy)",
      "def": "aimer : j'aime, tu aimes, il aime, nous aimons, vous aimez, ils aiment",
      "examples": [
        { "fr": "Tu aimes le football ?", "pl": "Lubisz piłkę nożną?" },
        { "fr": "Mes parents travaillent à Lyon.", "pl": "Moi rodzice pracują w Lyonie." }
      ],
      "tip": {
        "pl": "końcówki -e, -es, -e, -ons, -ez, -ent; -e, -es, -ent są nieme",
        "fr": "finales -e, -es, -e, -ons, -ez, -ent ; -e, -es, -ent ne se prononcent pas"
      },
      "tags": ["grammaire"]
    },
    {
      "id": "u02-preferer",
      "fr": "préférer",
      "pl": "woleć",
      "def": "je préfère, tu préfères, il préfère, nous préférons, vous préférez, ils préfèrent",
      "examples": [
        { "fr": "Je préfère la mer.", "pl": "Wolę morze." },
        { "fr": "Nous préférons la montagne.", "pl": "Wolimy góry." }
      ],
      "tip": {
        "pl": "é → è przy je, tu, il, ils (préfère); nous i vous zachowują é",
        "fr": "é → è avec je, tu, il, ils (préfère) ; nous et vous gardent é"
      },
      "confusables": ["u02-verbes-er"],
      "tags": ["grammaire"]
    },
    {
      "id": "u02-habiter",
      "fr": "habiter",
      "pl": "mieszkać",
      "def": "j'habite, tu habites, il habite, nous habitons, vous habitez, ils habitent",
      "examples": [
        { "fr": "J'habite à Poznań.", "pl": "Mieszkam w Poznaniu." },
        { "fr": "Ils habitent à la campagne.", "pl": "Mieszkają na wsi." }
      ],
      "tip": {
        "pl": "h jest nieme: j'habite (nie « je habite »), łączenie: nous_habitons",
        "fr": "le h est muet : j'habite (pas « je habite »), liaison : nous_habitons"
      },
      "tags": ["grammaire"]
    },
    {
      "id": "u02-possessifs-mon",
      "fr": "mon, ma, mes / ton, ta, tes / son, sa, ses",
      "pl": "mój, twój, jego / jej",
      "def": "le possessif s'accorde avec le nom possédé : mon père, ma mère, mes parents",
      "examples": [
        { "fr": "Je te présente ma sœur.", "pl": "Przedstawiam ci moją siostrę." },
        { "fr": "Julie habite avec son père.", "pl": "Julie mieszka ze swoim ojcem." }
      ],
      "tip": {
        "pl": "son / sa zależy od rzeczownika, nie od posiadacza: Julie i son père; przed samogłoską mon, ton, son: mon amie",
        "fr": "son / sa dépend du nom, pas du possesseur : Julie et son père ; devant une voyelle mon, ton, son : mon amie"
      },
      "confusables": ["u02-possessifs-notre"],
      "tags": ["grammaire"]
    },
    {
      "id": "u02-possessifs-notre",
      "fr": "notre, votre, leur / nos, vos, leurs",
      "pl": "nasz, wasz, ich",
      "def": "un seul objet : notre, votre, leur ; plusieurs objets : nos, vos, leurs",
      "examples": [
        { "fr": "Voici notre maison.", "pl": "Oto nasz dom." },
        { "fr": "Les enfants jouent avec leurs amis.", "pl": "Dzieci bawią się ze swoimi przyjaciółmi." }
      ],
      "tip": {
        "pl": "notre / votre / leur – jedna rzecz (r. męski i żeński), nos / vos / leurs – kilka rzeczy",
        "fr": "notre / votre / leur : un objet (masculin et féminin) ; nos / vos / leurs : plusieurs objets"
      },
      "confusables": ["u02-possessifs-mon"],
      "tags": ["grammaire"]
    },
    {
      "id": "u02-professions-feminin",
      "fr": "étudiant / étudiante, vendeur / vendeuse",
      "pl": "zawody w rodzaju żeńskim",
      "def": "+ e (avocate), -ien → -ienne, -er → -ère, -eur → -euse, -teur → -trice",
      "examples": [
        { "fr": "Ma mère est pharmacienne.", "pl": "Moja mama jest farmaceutką." },
        { "fr": "Je suis vendeuse.", "pl": "Jestem sprzedawczynią." }
      ],
      "tip": {
        "pl": "-ien → -ienne, -er → -ère, -eur → -euse, -teur → -trice; po être zawód bez rodzajnika: elle est infirmière",
        "fr": "-ien → -ienne, -er → -ère, -eur → -euse, -teur → -trice ; après être, pas d'article : elle est infirmière"
      },
      "tags": ["grammaire"]
    },
    { "id": "u02-parents", "fr": "les parents", "pl": "rodzice", "def": "le père et la mère", "examples": [{ "fr": "J'habite chez mes parents.", "pl": "Mieszkam u rodziców." }], "tags": ["vocabulaire"] },
    { "id": "u02-frere", "fr": "un frère", "pl": "brat", "def": "le fils de mes parents", "examples": [{ "fr": "J'ai un frère.", "pl": "Mam brata." }], "tags": ["vocabulaire"] },
