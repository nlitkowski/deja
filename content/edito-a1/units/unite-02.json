    { "id": "u02-tante", "fr": "une tante", "pl": "ciocia", "def": "la sœur de mon père ou de ma mère", "examples": [{ "fr": "Ma tante est infirmière.", "pl": "Moja ciocia jest pielęgniarką." }], "tags": ["vocabulaire"] },
