    { "id": "u02-tante", "fr": "une tante", "pl": "ciocia", "def": "la sœur de mon père ou de ma mère", "examples": [{ "fr": "Ma tante est infirmière.", "pl": "Moja ciocia jest pielęgniarką." }], "tags": ["vocabulaire"] },
    { "id": "u02-grands-parents", "fr": "les grands-parents", "pl": "dziadkowie", "def": "le grand-père et la grand-mère", "examples": [{ "fr": "Mes grands-parents habitent à Nice.", "pl": "Moi dziadkowie mieszkają w Nicei." }], "tags": ["vocabulaire"] },
    { "id": "u02-appartement", "fr": "un appartement", "pl": "mieszkanie", "def": "un logement dans un immeuble", "examples": [{ "fr": "J'habite dans un petit appartement.", "pl": "Mieszkam w małym mieszkaniu." }], "tags": ["vocabulaire"] },
    { "id": "u02-voisin", "fr": "un voisin / une voisine", "pl": "sąsiad / sąsiadka", "def": "une personne qui habite à côté de chez moi", "examples": [{ "fr": "Ma voisine est très sympa.", "pl": "Moja sąsiadka jest bardzo miła." }], "tags": ["vocabulaire"], "deprecated": true, "replacedBy": "u07-voisin" },
    { "id": "u02-cousin", "fr": "le cousin, la cousine", "pl": "kuzyn / kuzynka", "def": "l'enfant de mon oncle ou de ma tante", "examples": [{ "fr": "Mon cousin habite à Lyon.", "pl": "Mój kuzyn mieszka w Lyonie." }], "tip": { "pl": "cousin: n nieme (samogłoska nosowa), cousine: słychać n", "fr": "cousin : le n ne se prononce pas (voyelle nasale) ; cousine : on entend le n" }, "tags": ["vocabulaire"] }
  ],
