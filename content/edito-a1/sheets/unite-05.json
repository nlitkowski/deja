      "title": "Décrire un objet",
      "blocks": [
        {
          "type": "examples",
          "title": { "pl": "Do czego służy?", "fr": "Exprimer l'utilité" },
          "items": [
            { "fr": "Ça sert à quoi ? / À quoi ça sert ?", "pl": "Do czego to służy?" },
